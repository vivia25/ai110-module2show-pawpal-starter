classDiagram
    class Owner {
        +str first_name
        +str last_name
        +int age
        +str pet_type
        +List~Pet~ pets
        +add_pet(pet) void
        +get_tasks() List~Task~
    }

    class Pet {
        +str name
        +int age
        +str gender
        +str animal_type
        +List~Task~ tasks
        +add_task(task) void
    }

    class Task {
        +str task_type
        +str description
        +datetime due_time
        +bool completed
        +mark_complete() void
    }

    class Scheduler {
        +Owner owner
        +List~Task~ schedule
        +schedule_task(task, time) void
        +get_daily_schedule() List~Task~
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Owner "1" --> "*" Task : responsible for
    Scheduler "1" --> "1" Owner : schedules for
    Scheduler "1" --> "*" Task : organizes
